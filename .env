# Local development backend
# For Android Emulator: 10.0.2.2 (special alias to localhost)
# For Physical Device: Your machine's IP (e.g., 192.168.x.x)
# For production: https://attendpay-backend.onrender.com/api

EXPO_PUBLIC_API_URL=http://192.168.2.180/api

NODE_ENV=development

# Skip Expo CLI's online version-check (avoids "fetch failed" on restricted networks)
EXPO_OFFLINE=1
EXPO_NO_DEPENDENCY_VALIDATION=1
