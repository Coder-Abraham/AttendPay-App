{
  "expo": {
    "name": "AttendPay",
    "slug": "attendpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "attendpay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attendpay.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0060B8"
      },
      "package": "com.attendpay.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/uict-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clock.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0060B8",
          "dark": {
            "backgroundColor": "#0A2540"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AttendPay to access your camera to scan QR codes."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow AttendPay to access your location to record attendance.",
          "locationWhenInUsePermission": "Allow AttendPay to access your location to record attendance."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "bac69196-1d9e-4bb9-af70-0e46e08e134b"
      }
    },
    "owner": "attendpay-team"
  }
}
