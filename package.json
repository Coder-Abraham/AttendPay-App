  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "nativewind",
        "tailwindcss",
        "lucide-react-native",
        "react-native-qrcode-svg",
        "ajv",
        "@expo/vector-icons",
        "@react-navigation/bottom-tabs",
        "@react-navigation/elements",
        "@react-navigation/native",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-web"
