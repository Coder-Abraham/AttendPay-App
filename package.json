    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android",
    "ios": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios",
    "web": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.2.0",
    "@react-navigation/native": "^7.0.14",
    "ajv": "^8.17.1",
    "expo": "^52.0.0",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.22",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "lucide-react-native": "^0.475.0",
