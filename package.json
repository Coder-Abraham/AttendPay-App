{
  "name": "attendpay",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android",
    "ios": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios",
    "web": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "@expo/vector-icons": "^14.0.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "~52.0.46",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.3.1",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.20",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~4.0.9",
    "expo-web-browser": "~14.0.2",
    "lucide-react-native": "^0.475.0",
    "nativewind": "^4.1.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "nativewind",
        "tailwindcss",
        "lucide-react-native",
        "react-native-qrcode-svg"
      ]
