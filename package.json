{
  "name": "attendpay",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android",
    "ios": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios",
    "web": "cross-env EXPO_OFFLINE=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web",
    "lint": "expo lint",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1",
    "build:apk:local": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1 -ApiUrl http://YOUR_LAN_IP:8000/api",
    "build:apk:eas": "eas build --platform android --profile preview --local",
    "prebuild:android": "expo prebuild --platform android --clean"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "@expo/vector-icons": "^14.0.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.475.0",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "~3.17.0",
    "react-native-safe-area-context": "~5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~9.1.0",
    "typescript": "~5.3.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "nativewind",
        "tailwindcss",
        "lucide-react-native",
        "react-native-qrcode-svg",
        "ajv",
        "@expo/vector-icons",
        "@react-navigation/bottom-tabs",
        "@react-navigation/elements",
        "@react-navigation/native",
        "react-native-reanimated",
        "react-native-gesture-handler",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-svg",
        "react-native-web"
      ]
    }
  }
}
